<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>winecellar</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>winecellar</name>
    <description>Vinkällare - webbapp för att hålla reda på en vinsamling</description>

    <properties>
        <java.version>21</java.version>
        <cucumber.version>7.18.1</cucumber.version>
        <testcontainers.version>1.21.4</testcontainers.version>
        <playwright.version>1.61.0</playwright.version>
        <!-- Mockitos bytebuddy-baserade mock maker behöver en nyare version än
             den Spring Boot 3.3.4 pekar ut som standard för att kunna
             instrumentera klasser på nyare JDK:er än de BOM:en testats mot. -->
        <mockito.version>5.23.0</mockito.version>
        <!-- Samma version som den tidigare fristående tools/import-excel-modulen
             använde (WINE-20, se ADR 0014) - POI blir nu ett riktigt
             runtime-beroende av den deployade appen. -->
        <poi.version>5.2.5</poi.version>
        <!-- Markdown-tolkning av chattassistentens svar (WINE-53) - se
             ChatMarkdownRenderer (web-paketet). -->
        <commonmark.version>0.24.0</commonmark.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Mockito 5.23.0 pekar fortfarande ut en byte-buddy som inte kan
                 instrumentera klasser på den JDK vi bygger med här - tvinga
                 fram en nyare byte-buddy tills mockito-bom hinner ikapp. -->
            <dependency>
                <groupId>net.bytebuddy</groupId>
                <artifactId>byte-buddy</artifactId>
                <version>1.18.11-jdk5</version>
            </dependency>
            <dependency>
                <groupId>net.bytebuddy</groupId>
                <artifactId>byte-buddy-agent</artifactId>
                <version>1.18.11-jdk5</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Applikation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- Ger sec:*-dialekten och auto-injicerar CSRF-hidden-fältet i varje
             th:action-formulär - annars måste varje formulär (login.html,
             vin-formular.html, ...) lägga till fältet manuellt. -->
        <dependency>
            <groupId>org.thymeleaf.extras</groupId>
            <artifactId>thymeleaf-extras-springsecurity6</artifactId>
        </dependency>

        <!-- Persistens -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Excel-import/export (WINE-20, se ADR 0014) - tidigare bara ett
             beroende av den fristående tools/import-excel-modulen, nu ett
             riktigt runtime-beroende av den deployade appen eftersom
             funktionen blir en webbfunktion. -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
        </dependency>

        <!-- Markdown-till-HTML för chattassistentens fria textsvar (WINE-53,
             se ChatMarkdownRenderer i web-paketet) - assistentens svar
             kommer kodade som markdown-syntax (rubriker, listor, fetstil)
             från Anthropics API och visades tidigare som rå text. Vald
             framför en handskriven regex-omvandling eftersom källtexten är
             opålitlig indata (en extern LLM-tjänsts svar, i teorin även
             påverkbar av en användares egna chattmeddelanden via
             prompt-injektion) - escapeHtml/sanitizeUrls (aktiverade i
             ChatMarkdownRenderer) stänger av CommonMark-specifikationens
             annars tillåtna genomsläpp av rå HTML respektive farliga
             länkscheman (t.ex. "javascript:") i källtexten. Bara
             kärnspecifikationen (ingen GFM-tabellextension) - tillräckligt
             för rubriker/listor/fetstil/kod, och håller beroendet minimalt
             i linje med projektets övriga, medvetet få beroenden. -->
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark</artifactId>
            <version>${commonmark.version}</version>
        </dependency>

        <!-- Test: enhets- och integrationsnivå -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Test: acceptansnivå (Specification by Example) -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <version>${cucumber.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-junit-platform-engine</artifactId>
            <version>${cucumber.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-spring</artifactId>
            <version>${cucumber.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Explicit motor för @Suite - vissa BOM-kombinationer ger bara
             junit-platform-suite-api transitivt via ovanstående, inte
             själva motorn som faktiskt kör suiten. -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite-engine</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers: riktig Postgres i acceptanstesterna, inte mockad -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- UI-test (WineListResponsiveIT): Playwright verifierar faktiskt
             responsivt beteende (table- vs kort-vy), inte bara renderad HTML. -->
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>${playwright.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- Acceptans-/UI-tester (*IT.java) körs separat från enhetstester,
                 i integration-test/verify-fasen. `mvn test` kör bara snabba
                 enhetstester, `mvn verify` kör hela kedjan - se CLAUDE.md. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
